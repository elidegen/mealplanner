generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Home {
  id          Int           @id @default(autoincrement())
  name        String
  password    String
  users       HomeMembership[]
  meals       Meal[]
  listEntrys  ListEntry[]
  tags        Tag[]
  ingredients Ingredient[]
}

model HomeMembership {
  id          Int           @id @default(autoincrement())
  homeId      Int
  userId      Int
  role        String
  lastLogin   DateTime
  home        Home          @relation(fields: [homeId], references: [id])
  user        User          @relation(fields: [userId], references: [id])
}

model User {
  id           Int          @id @default(autoincrement())
  email        String       @unique
  name         String
  passwordHash String
  homes        HomeMembership[]
}

model Meal {
  id           Int          @id @default(autoincrement())
  name         String
  macroId      Int?
  macros       Macros?       @relation(fields: [macroId], references: [id])
  ingredients  Ingredient[]
  tags         Tag[]
  portions     Int
  instructions String?
  home         Home?        @relation(fields: [homeId], references: [id])
  homeId       Int?
  public       Boolean
}

model Ingredient {
  id     Int                @id @default(autoincrement())
  name   String
  amount Float
  unit   String
  homeId Int
  mealId Int
  home   Home               @relation(fields: [homeId], references: [id])
  meal   Meal               @relation(fields: [mealId], references: [id], onDelete: Cascade)
}

model Macros {
  id       Int              @id @default(autoincrement())
  calories Int?
  carbs    Int?
  proteins Int?
  fat      Int?
  meals    Meal[]
}

model Tag {
  id     Int                @id @default(autoincrement())
  name   String            
  homeId Int
  home   Home               @relation(fields: [homeId], references: [id])
  meals  Meal[]
  @@unique([name, homeId])       
}

model ListEntry {
  id     Int                @id @default(autoincrement())
  name   String
  amount Float
  unit   String
  homeId Int
  home   Home               @relation(fields: [homeId], references: [id])
  list   String
}
