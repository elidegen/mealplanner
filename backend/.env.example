# Vorlage fuer die lokale Entwicklung OHNE Docker:
#   cp .env.example .env
#
# Beim Start per "docker compose up" wird diese Datei nicht gebraucht -
# dort kommen die Werte aus der compose.yaml.

# Pfad zur SQLite-Datei, relativ zum prisma-Verzeichnis
DATABASE_URL="file:./dev.db"

# Signiert die JWTs. Lokal beliebig waehlbar, aber mindestens 32 Zeichen.
# NIEMALS den Beispielwert in einem echten Deployment verwenden.
JWT_SECRET="bitte-eigenen-schluessel-mit-mindestens-32-zeichen-setzen"

# Port, auf dem die API lauscht
PORT=3000

# Erlaubte Herkunft fuer CORS - im Normalfall der Vite-Dev-Server
CORS_ORIGIN="http://localhost:5173"
